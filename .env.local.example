# Copy this file to `.env.local` and fill in values from your Supabase project
# (Supabase Dashboard → Project Settings → API)

# Public — safe to expose to the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser. Used for admin/seed scripts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
